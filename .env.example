# Copiar a .env y completar. .env no se commitea (FR-053).
# El modo (DRY/LIVE) lo fija el comando: pnpm dev = DRY, pnpm start = LIVE.

# IA (FR-004)
ANTHROPIC_API_KEY=

# WhatsApp (FR-048, FR-049)
# 32 bytes en hex (64 caracteres) o base64. Ej.: openssl rand -hex 32
WHATSAPP_SESSION_KEY=
WHATSAPP_GROUP_NAME=
# Remitentes autorizados, separados por coma (FR-002)
AUTHORIZED_SENDERS=

# Binance Demo Trading, modo DRY (FR-052)
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Binance producción, modo LIVE: key SOLO con permiso de trading, sin retiro (FR-054)
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Configuración del operador: todos > 0 (FR-062)
RISK_R_USDT=
MAX_POSITIONS=
MAX_CAPITAL_USDT=
MAX_POSITION_USDT=
MAX_LEVERAGE=
SYMBOL_LEVERAGE=
# Opcional, por defecto 15 (FR-013)
MAX_SL_DISTANCE_PCT=15

# Opcional, por defecto data
SIGNALBRIDGE_DATA_DIR=
