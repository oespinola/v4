{
  "name": "signalbridge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "SIGNALBRIDGE_MODE=DRY tsx scripts/supervise.ts",
    "start": "SIGNALBRIDGE_MODE=LIVE tsx scripts/supervise.ts",
    "dev:verbose": "SIGNALBRIDGE_MODE=DRY SIGNALBRIDGE_VERBOSE=1 tsx scripts/supervise.ts",
    "start:verbose": "SIGNALBRIDGE_MODE=LIVE SIGNALBRIDGE_VERBOSE=1 tsx scripts/supervise.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "latency": "tsx scripts/latency.ts",
    "dev:once": "SIGNALBRIDGE_MODE=DRY tsx src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "ccxt": "^4.5.85",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
